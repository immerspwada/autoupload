# ─────────────────────────────────────────────────────────────────
# YouTube Auto Uploader — Environment Variables
# สำหรับ local: cp .env.example .env  แล้วแก้ค่า
# สำหรับ cloud: ตั้งใน platform Variables panel (ไม่ต้องสร้าง .env file)
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── App URL (สำคัญสำหรับ OAuth redirect) ──────────────────────────
# Railway:  ตั้งอัตโนมัติจาก RAILWAY_PUBLIC_DOMAIN — ไม่ต้องตั้ง
# Fly.io:   APP_URL=https://autoupload.fly.dev
# Render:   APP_URL=https://autoupload.onrender.com
# VPS:      APP_URL=https://yourdomain.com
# APP_URL=https://your-app.railway.app

# ── Puppeteer (ตั้งอัตโนมัติใน Dockerfile) ────────────────────────
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── YouTube Quota ──────────────────────────────────────────────────
# Default: 10,000 units/day (free tier) = 6 uploads/day
# หลังได้รับ Extended Quota จาก Google:
# YOUTUBE_QUOTA_LIMIT=1000000

# ── Security ──────────────────────────────────────────────────────
# ★ แนะนำอย่างยิ่งถ้าเปิดใช้จากเน็ตเวิร์ก (HOST=0.0.0.0)
#   ไม่ตั้ง = คำสั่งอันตราย (ลบวิดีโอ, จัดการ account, ล้างประวัติ)
#            ทำได้จากเครื่องที่รันระบบเท่านั้น — เครื่องอื่นจะได้ 403
#   ตั้งแล้ว = ต้อง login ก่อนใช้ API ทุกตัว
# DASHBOARD_PASSWORD=your_secure_password_here

# secret สำหรับเซ็น session cookie — ไม่ตั้ง = สุ่มใหม่ทุก restart (ต้อง login ใหม่)
# SESSION_SECRET=random_long_string_here

# ── Network binding ───────────────────────────────────────────────
# 0.0.0.0 = เข้าถึงได้จากทุกเครื่องในเน็ตเวิร์ก (ค่าเริ่มต้น)
# 127.0.0.1 = เฉพาะเครื่องนี้เท่านั้น (ปลอดภัยสุด)
# HOST=0.0.0.0

# ── Limits & Timeouts ─────────────────────────────────────────────
# BODY_LIMIT=4mb                    # ขนาด JSON body สูงสุด
# RATE_LIMIT_MAX=600                # คำขอต่อ IP ต่อนาที
# MAX_BATCH_VIDEOS=100              # จำนวนคลิปต่อ batch
# SHUTDOWN_TIMEOUT_MS=20000         # เวลาสูงสุดในการปิดระบบ
# REJECTION_LIMIT=10                # unhandled rejection/นาที ก่อน restart
# DISK_MIN_FREE_BYTES=2147483648    # พื้นที่ว่างขั้นต่ำ (2GB) ก่อนเริ่มงานใหม่
# VT_CONCURRENCY=1                  # งาน ffmpeg พร้อมกันสูงสุด
# VT_TIMEOUT=180000                 # timeout transform 1 ไฟล์
# YT_UPLOAD_TIMEOUT=900000          # timeout อัปโหลด 1 คลิป
# SCHEDULER_QUEUE_WAIT_MAX=2700000  # เพดานเวลารอคิวว่างในลูปต่อเนื่อง

# ── Google OAuth Credentials ──────────────────────────────────────
# ★ วิธีที่ดีกว่า: upload client_secret.json ผ่าน Volume
# หรือใส่ JSON string ตรงนี้ (สำหรับ platform ที่ไม่มี volume เช่น Render)
# GOOGLE_CLIENT_ID=613869038728-xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
